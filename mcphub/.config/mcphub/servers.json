{
  "mcpServers": {
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "autoApprove": [
        "resolve-library-id",
        "query-docs"
      ],
      "command": "npx"
    },
    "docker-mcp": {
      "args": [
        "docker-mcp"
      ],
      "autoApprove": [
        "list-containers",
        "get-logs"
      ],
      "command": "/Users/charliehowes/.local/bin/uvx",
      "disabled": false
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/charliehowes/Desktop",
        "/Users/charliehowes/Projects"
      ],
      "autoApprove": [
        "get_file_info",
        "list_allowed_directories",
        "list_directory",
        "read_file",
        "read_multiple_files",
        "search_files",
        "list_directory_with_sizes",
        "read_media_file",
        "read_text_file",
        "directory_tree"
      ],
      "command": "npx",
      "disabled": false
    },
    "git": {
      "args": [
        "mcp-server-git"
      ],
      "autoApprove": [
        "git_diff",
        "git_diff_staged",
        "git_diff_unstaged",
        "git_log",
        "git_show",
        "git_status"
      ],
      "command": "/Users/charliehowes/.local/bin/uvx",
      "disabled": false
    },
    "godoc": {
      "args": [
        "run",
        "github.com/yikakia/godoc-mcp-server/cmd/godoc-mcp-server@latest"
      ],
      "autoApprove": [
        "getPackageInfo",
        "searchPackages"
      ],
      "command": "go"
    },
    "mcp-mermaid": {
      "args": [
        "-y",
        "mcp-mermaid"
      ],
      "autoApprove": [
        "generate_mermaid_diagram"
      ],
      "command": "npx",
      "disabled": true
    }
  },
  "nativeMCPServers": {
    "mcphub": {
      "autoApprove": [
        "get_current_servers"
      ]
    },
    "neovim": {
      "autoApprove": [
        "find_files",
        "list_directory",
        "read_file",
        "read_multiple_files"
      ]
    }
  }
}
