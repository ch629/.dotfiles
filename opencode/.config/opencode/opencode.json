{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "developer-primary",
    "instructions": [
        "policies/governance-profiles.md"
    ],
    "formatter": {
        "gofmt": {
            "command": [
                "gofumpt",
                "-w",
                "$FILE"
            ]
        }
    },
    "shell": "zsh",
    "disabled_providers": [],
    "provider": {
        "gateframe": {
            "name": "Betika Gateframe",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://router.gateframe.ai/v1",
                "headers": {
                    "Authorization": "Bearer {env:GATEFRAME_TOKEN}"
                }
            },
            "models": {
                "gateframe/gpt-5.3-codex": {
                    "name": "Gateframe Codex"
                },
                "gateframe/gpt-5.4": {
                    "name": "Gateframe GPT"
                },
                "gateframe/gpt-5.4-mini": {
                    "name": "Gateframe GPT Mini"
                }
            }
        }
    }
}
