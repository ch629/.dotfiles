{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "developer-personal",
    "instructions": [
        "policies/governance-profiles.md"
    ],
    "formatter": {
        "gofmt": {
            "command": [
                "gofumpt",
                "-w",
                "$FILE"
            ]
        }
    },
    "shell": "zsh",
    "disabled_providers": [],
    "provider": {
        "gateframe": {
            "name": "Betika Gateframe",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://router.gateframe.ai/v1",
                "headers": {
                    "Authorization": "Bearer {env:GATEFRAME_TOKEN}"
                }
            },
            "models": {
                "gateframe/gpt-5.3-codex": {
                    "name": "Gateframe GPT-5.3-Codex"
                },
                "gateframe/gpt-5.4": {
                    "name": "Gateframe GPT-5.4"
                },
                "gateframe/chatgpt-5.4": {
                    "name": "Gateframe ChatGPT-5.4"
                },
                "gateframe/gemini-3.5-flash": {
                    "name": "Gateframe Gemini 3.5 Flash"
                },
                "gateframe/minimax-2.7": {
                    "name": "Gateframe Minimax 2.7"
                },
                "gateframe/qwen3.6-plus": {
                    "name": "Gateframe Qwen 3.6 Plus"
                }
            }
        }
    }
}
