{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "quick-dev",
  "instructions": ["policies/governance-profiles.md", "policies/worktrees.md", "policies/user-interaction.md"],
  "permission": {
    "worktree_merge": "deny",
    "external_directory": {
      "*": "ask",
      "~/.config/opencode/agents/*": "allow",
      "~/.config/opencode/playbooks/*": "allow",
      "~/.config/opencode/policies/*": "allow",
      "~/.config/opencode/newagents/prompts/*": "allow",
      "~/.config/opencode/newagents/playbooks/*": "allow",
      "~/.config/opencode/newagents/policies/*": "allow",
      "~/.config/opencode/skills/*": "allow",
      "~/.claude/skills/*": "allow",
      "~/.dotfiles/opencode/.config/opencode/agents/*": "allow",
      "~/.dotfiles/opencode/.config/opencode/playbooks/*": "allow",
      "~/.dotfiles/opencode/.config/opencode/policies/*": "allow",
      "~/.dotfiles/opencode/.config/opencode/newagents/prompts/*": "allow",
      "~/.dotfiles/opencode/.config/opencode/newagents/playbooks/*": "allow",
      "~/.dotfiles/opencode/.config/opencode/newagents/policies/*": "allow",
      "~/.dotfiles/opencode/.config/opencode/skills/*": "allow"
    },
    "edit": {
      "~/.config/opencode/agents/*": "ask",
      "~/.config/opencode/playbooks/*": "ask",
      "~/.config/opencode/policies/*": "ask",
      "~/.config/opencode/newagents/prompts/*": "ask",
      "~/.config/opencode/newagents/playbooks/*": "ask",
      "~/.config/opencode/newagents/policies/*": "ask",
      "~/.config/opencode/skills/*": "ask",
      "~/.claude/skills/*": "ask",
      "~/.dotfiles/opencode/.config/opencode/agents/*": "ask",
      "~/.dotfiles/opencode/.config/opencode/playbooks/*": "ask",
      "~/.dotfiles/opencode/.config/opencode/policies/*": "ask",
      "~/.dotfiles/opencode/.config/opencode/newagents/prompts/*": "ask",
      "~/.dotfiles/opencode/.config/opencode/newagents/playbooks/*": "ask",
      "~/.dotfiles/opencode/.config/opencode/newagents/policies/*": "ask",
      "~/.dotfiles/opencode/.config/opencode/skills/*": "ask"
    }
  },
  "formatter": {
    "gofmt": {
      "command": ["gofumpt", "-w", "$FILE"]
    }
  },
  "shell": "zsh",
  "command": {
    "audit-permissions": {
      "description": "Shows permission audit summary and suggests new allowlist patterns based on commands you've approved manually",
      "template": "Run `bun ~/.config/opencode/scripts/permission-audit-summary.ts suggest:all` and present findings grouped by agent. For each agent's suggestions, ask the user which ones they want to add to that agent's bash permission block, then apply the approved ones."
    }
  },
  "lsp": true,
  "disabled_providers": [],
  "provider": {
    "gateframe": {
      "name": "Betika Gateframe",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://router.gateframe.ai/v1",
        "headers": {
          "Authorization": "Bearer {env:GATEFRAME_TOKEN}"
        }
      },
      "models": {
        "gateframe/qwen3.6-plus": {
          "name": "Gateframe Qwen 3.6 Plus"
        },
        "anthropic/claude-opus-4-8": {
          "name": "Anthropic Claude Opus 4-8"
        }
      }
    },
    "claude-wrapper": {
      "name": "Claude (local CLI)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "opus": {
          "name": "Claude Opus 4.8",
          "reasoning": true,
          "tool_call": true,
          "attachment": false,
          "temperature": false,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "sonnet": {
          "name": "Claude Sonnet 4.6",
          "reasoning": true,
          "tool_call": true,
          "attachment": false,
          "temperature": false,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "haiku": {
          "name": "Claude Haiku 4.5",
          "reasoning": true,
          "tool_call": true,
          "attachment": false,
          "temperature": false,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  },
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:TAVILY_API_KEY}"
      },
      "oauth": false,
      "enabled": true
    }
  },
  "plugin": [
    ["https://github.com/afwlehmann/opencode-worktree-plugin/releases/download/v0.7.0/opencode-worktree-plugin-0.7.0.tgz", {"permissionMode": "pedantic"}],
    "@mohak34/opencode-notifier",
    "@tarquinen/opencode-dcp@latest",
    "./.opencode/plugins/strip-top-p.ts",
    "./.opencode/plugins/ponytail/.opencode/plugins/ponytail.mjs",
    "../../.opencode/plugins/permission-audit.ts"
  ]
}
